# OpenRouter / Jev API Key (optional - needed only for LLM move explanations)
JEV_API_KEY=

# Engine and model tunables (all have sensible defaults)
# COACH_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# COACH_DEPTH=18
# COACH_MOVE_THRESHOLD=6
# COACH_MOVE_CONFIDENCE=6
# COACH_SOFT_SLACK=2
# COACH_THREAT_DEPTH=12
# COACH_LOG=1

# Dashboard. It is served either way and the URL is printed on startup; set
# COACH_OPEN=1 only if the board is on another monitor, or the browser window
# will cover the board the coach is watching.
# COACH_OPEN=1
# COACH_PORT=7171
# COACH_DASHBOARD=0

# Play sessions (npm run play). A separate port so it can run beside the
# dashboard. Grading stays at COACH_DEPTH; only the opponent's replies use this.
# COACH_PLAY_PORT=7272
# COACH_PLAY_OPP_DEPTH=12
